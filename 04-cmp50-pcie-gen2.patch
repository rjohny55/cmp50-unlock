diff --git a/kernel-open/nvidia/nv.c b/kernel-open/nvidia/nv.c
index b771a00..2d22626 100644
--- a/kernel-open/nvidia/nv.c
+++ b/kernel-open/nvidia/nv.c
@@ -65,6 +65,10 @@
 
 #include <linux/firmware.h>
 #include <linux/cdev.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/pci.h>
+#include <uapi/linux/pci_regs.h>
 
 #include <sound/core.h>             /* HDA struct snd_card */
 
@@ -1362,6 +1366,220 @@ nv_schedule_uvm_resume_p2p(NvU8 *pUuid)
 #endif
 }
 
+static NvBool
+nv_cmp50hx_is_supported(struct pci_dev *gpu)
+{
+    return (gpu != NULL) &&
+           (gpu->vendor == PCI_VENDOR_ID_NVIDIA) &&
+           (gpu->device == 0x1e09) &&
+           (((gpu->subsystem_vendor == PCI_VENDOR_ID_NVIDIA) &&
+             (gpu->subsystem_device == 0x1554)) ||
+            ((gpu->subsystem_vendor == 0x1462) &&
+             (gpu->subsystem_device == 0x371f)));
+}
+
+static void
+nv_cmp50hx_retrain_gen2(nv_state_t *nv)
+{
+    nv_linux_state_t *nvl = NV_GET_NVL_FROM_NV_STATE(nv);
+    struct pci_dev *gpu = nvl->pci_dev;
+    struct pci_dev *upstream;
+    void __iomem *bar0;
+    u16 gpu_ctl;
+    u16 gpu_ctl2;
+    u16 upstream_ctl;
+    u16 upstream_ctl2;
+    u16 gpu_ctl2_readback;
+    u16 upstream_ctl2_readback;
+    u16 link_status = 0;
+    u16 upstream_status = 0;
+    u32 cya0;
+    u32 link_config;
+    u32 pl_link_rate;
+    int ret;
+    int attempt;
+
+    if (!nv_cmp50hx_is_supported(gpu))
+        return;
+
+    upstream = pci_upstream_bridge(gpu);
+    if (upstream == NULL)
+    {
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "CMP50_GEN2: no upstream bridge; retrain skipped\n");
+        return;
+    }
+
+    bar0 = ioremap(pci_resource_start(gpu, 0), 0x90000);
+    if (bar0 == NULL)
+    {
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "CMP50_GEN2: BAR0 map failed; retrain skipped\n");
+        return;
+    }
+
+    cya0 = readl(bar0 + 0x8c2c0);
+    link_config = readl(bar0 + 0x8c040);
+    pl_link_rate = readl(bar0 + 0x8c1c0);
+    if (((cya0 & (1U << 2)) != 0U) ||
+        (((link_config >> 18) & 3U) != 2U) ||
+        ((pl_link_rate & 0x00060000U) != 0x00040000U))
+    {
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "CMP50_GEN2: GSP policy missing CYA=%08x CFG=%08x "
+                      "PL=%08x; retrain skipped\n",
+                      cya0, link_config, pl_link_rate);
+        iounmap(bar0);
+        return;
+    }
+
+    ret = pcie_capability_read_word(gpu, PCI_EXP_LNKCTL, &gpu_ctl);
+    if (ret)
+        goto capability_error_unmap;
+    ret = pcie_capability_read_word(gpu, PCI_EXP_LNKCTL2, &gpu_ctl2);
+    if (ret)
+        goto capability_error_unmap;
+    ret = pcie_capability_read_word(upstream, PCI_EXP_LNKCTL,
+                                    &upstream_ctl);
+    if (ret)
+        goto capability_error_unmap;
+    ret = pcie_capability_read_word(upstream, PCI_EXP_LNKCTL2,
+                                    &upstream_ctl2);
+    if (ret)
+        goto capability_error_unmap;
+
+    /*
+     * Program both target speeds, ask the endpoint for Recovery first, then
+     * request Recovery at the downstream port.  Preserve ASPM exactly: the
+     * tested Intel IIO link changes speed from L1, while clearing ASPM before
+     * Retrain made this 20 GB endpoint return to Gen1.
+     */
+    gpu_ctl2 = (gpu_ctl2 & ~PCI_EXP_LNKCTL2_TLS) |
+               PCI_EXP_LNKCTL2_TLS_5_0GT;
+    upstream_ctl2 = (upstream_ctl2 & ~PCI_EXP_LNKCTL2_TLS) |
+                    PCI_EXP_LNKCTL2_TLS_5_0GT;
+    ret = pcie_capability_write_word(gpu, PCI_EXP_LNKCTL2, gpu_ctl2);
+    if (ret)
+        goto restore_ctl_unmap;
+    ret = pcie_capability_write_word(upstream, PCI_EXP_LNKCTL2,
+                                     upstream_ctl2);
+    if (ret)
+        goto restore_ctl_unmap;
+    ret = pcie_capability_read_word(gpu, PCI_EXP_LNKCTL2,
+                                    &gpu_ctl2_readback);
+    if (ret)
+        goto restore_ctl_unmap;
+    ret = pcie_capability_read_word(upstream, PCI_EXP_LNKCTL2,
+                                    &upstream_ctl2_readback);
+    if (ret)
+        goto restore_ctl_unmap;
+    if (((gpu_ctl2_readback & PCI_EXP_LNKCTL2_TLS) !=
+         PCI_EXP_LNKCTL2_TLS_5_0GT) ||
+        ((upstream_ctl2_readback & PCI_EXP_LNKCTL2_TLS) !=
+         PCI_EXP_LNKCTL2_TLS_5_0GT))
+    {
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "CMP50_GEN2: target readback failed GPU=%04x ROOT=%04x\n",
+                      gpu_ctl2_readback, upstream_ctl2_readback);
+        goto restore_ctl_unmap;
+    }
+
+    writel(6U, bar0 + 0x8872c);
+    (void)readl(bar0 + 0x8872c);
+    iounmap(bar0);
+    bar0 = NULL;
+    msleep(20);
+
+    ret = pcie_capability_write_word(gpu, PCI_EXP_LNKCTL,
+                                     gpu_ctl | PCI_EXP_LNKCTL_RL);
+    if (ret)
+        goto restore_ctl;
+    msleep(50);
+    ret = pcie_capability_write_word(upstream, PCI_EXP_LNKCTL,
+                                     upstream_ctl | PCI_EXP_LNKCTL_RL);
+    if (ret)
+        goto restore_ctl;
+
+    for (attempt = 0; attempt < 200; attempt++)
+    {
+        msleep(10);
+        ret = pcie_capability_read_word(gpu, PCI_EXP_LNKSTA, &link_status);
+        (void)pcie_capability_read_word(upstream, PCI_EXP_LNKSTA,
+                                        &upstream_status);
+        if (!ret &&
+            ((link_status & PCI_EXP_LNKSTA_CLS) >=
+             PCI_EXP_LNKSTA_CLS_5_0GB))
+        {
+            NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                          "CMP50_GEN2: RETRAIN_PASS GPU=%04x ROOT=%04x "
+                          "attempt=%d\n",
+                          link_status, upstream_status, attempt + 1);
+            (void)pcie_capability_write_word(gpu, PCI_EXP_LNKCTL, gpu_ctl);
+            (void)pcie_capability_write_word(upstream, PCI_EXP_LNKCTL,
+                                              upstream_ctl);
+            return;
+        }
+    }
+
+    /*
+     * The 20 GB board can expose the complete Gen2 policy before its RM PCIe
+     * state accepts the first Recovery request.  A later identical request
+     * succeeds without dropping DL_Active, so retry once after the initial
+     * two-second observation window.
+     */
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP50_GEN2: RETRAIN_RETRY GPU=%04x ROOT=%04x\n",
+                  link_status, upstream_status);
+    msleep(500);
+    ret = pcie_capability_write_word(gpu, PCI_EXP_LNKCTL,
+                                     gpu_ctl | PCI_EXP_LNKCTL_RL);
+    if (ret)
+        goto restore_ctl;
+    msleep(50);
+    ret = pcie_capability_write_word(upstream, PCI_EXP_LNKCTL,
+                                     upstream_ctl | PCI_EXP_LNKCTL_RL);
+    if (ret)
+        goto restore_ctl;
+
+    for (attempt = 0; attempt < 200; attempt++)
+    {
+        msleep(10);
+        ret = pcie_capability_read_word(gpu, PCI_EXP_LNKSTA, &link_status);
+        (void)pcie_capability_read_word(upstream, PCI_EXP_LNKSTA,
+                                        &upstream_status);
+        if (!ret &&
+            ((link_status & PCI_EXP_LNKSTA_CLS) >=
+             PCI_EXP_LNKSTA_CLS_5_0GB))
+        {
+            NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                          "CMP50_GEN2: RETRAIN_PASS GPU=%04x ROOT=%04x "
+                          "attempt=%d\n",
+                          link_status, upstream_status, attempt + 201);
+            (void)pcie_capability_write_word(gpu, PCI_EXP_LNKCTL, gpu_ctl);
+            (void)pcie_capability_write_word(upstream, PCI_EXP_LNKCTL,
+                                              upstream_ctl);
+            return;
+        }
+    }
+
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP50_GEN2: RETRAIN_FAIL GPU=%04x ROOT=%04x ret=%d\n",
+                  link_status, upstream_status, ret);
+restore_ctl:
+    (void)pcie_capability_write_word(gpu, PCI_EXP_LNKCTL, gpu_ctl);
+    (void)pcie_capability_write_word(upstream, PCI_EXP_LNKCTL, upstream_ctl);
+    return;
+
+restore_ctl_unmap:
+    (void)pcie_capability_write_word(upstream, PCI_EXP_LNKCTL, upstream_ctl);
+    (void)pcie_capability_write_word(gpu, PCI_EXP_LNKCTL, gpu_ctl);
+capability_error_unmap:
+    iounmap(bar0);
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP50_GEN2: PCI capability error=%d; retrain stopped\n",
+                  ret);
+}
+
 /*
  * Brings up the device on the first file open. Assumes nvl->ldata_lock is held.
  */
@@ -1521,6 +1739,8 @@ int nv_start_device(nv_state_t *nv, nvidia_stack_t *sp)
         goto failed_release_irq;
     }
 
+    nv_cmp50hx_retrain_gen2(nv);
+
     /* Generate and cache the UUID for future callers */
     (void)rm_get_gpu_uuid_raw(sp, nv);
 
